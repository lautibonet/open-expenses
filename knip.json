{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/test-setup.ts",
    "src/**/*.spec.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": [
    "prettier"
  ],
  "rules": {
    "duplicates": "off"
  }
}
